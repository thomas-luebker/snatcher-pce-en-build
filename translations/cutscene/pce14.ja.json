"text": "ダメだ"
},
{
"t0": 3.2,
"t1": 4.36,
"text": "私だってジャンカーよ"
},
{
"t0": 4.36,
"t1": 4.98,
"text": "わかってる"
},
{
"t0": 4.98,
"t1": 6.4,
"text": "君も立派なジャンカーだ"
},
{
"t0": 6.4,
"t1": 7.08,
"text": "だったら"
},
{
"t0": 7.08,
"t1": 9.94,
"text": "君はサミット会長で客人たちを護衛してくれ"
},
{
"t0": 10.3,
"t1": 11.88,
"text": "ヤサラが諦めたとは思えん"
},
{
"t0": 12.28,
"t1": 13.64,
"text": "サミットって京都よ"
},
{
"t0": 14.52,
"t1": 15.74,
"text": "私だけ逃げるなんて"
},
{
"t0": 15.74,
"t1": 18.78,
"text": "シティに過去を落とさないように説得してください"
},
{
"t0": 18.78,
"t1": 20.52,
"text": "ヤサラのアジトがわかったんだ"
},
{
"t0": 20.52,
"t1": 22.04,
"text": "島ごと沈める必要はない"
},
{
"t0": 22.36,
"t1": 22.64,
"text": "でも"
},
{
"t0": 23.16,
"t1": 24.28,
"text": "困難な仕事だぞ"
},
{
"t0": 24.28,
"t1": 24.88,
"text": "できるか"
},
{
"t0": 25.91,
"t1": 26.83,
"text": "わかったわ"
},
{
"t0": 27.55,
"t1": 29.79,
"text": "ギリアン、なんとかやってみる"
},
{
"t0": 29.79,
"t1": 31.43,
"text": "ミカ、ありがとう"
},
{
"t0": 32.09,
"t1": 33.47,
"text": "言わないでそんなこと"
},
{
"t0": 34.2,
"t1": 35.3,
"text": "さあ、いきましょう。"
},
{
"t0": 37.59,
"t1": 38.53,
"text": "ジリアン!"
},
{
"t0": 39.11,
"t1": 39.39,
"text": "ママ"
},
{
"t0": 40.97,
"t1": 41.83,
"text": "あの…"
},
{
"t0": 45.18,
"t1": 47.22,
"text": "今度、食事でもどう?"
},
{
"t0": 47.76,
"t1": 48.48,
"text": "食事?"
},
{
"t0": 48.94,
"t1": 51.5,
"text": "え、そう、食事"
},
{
"t0": 52.24,
"t1": 52.94,
"text": "アニカ"
},
{
"t0": 53.59,
"t1": 54.19,
"text": "ダメ?"
},
{
"t0": 55.5,
"t1": 56.64,
"text": "思いっきりオシャレして"
},
{
"t0": 57.48,
"t1": 58.46,
"text": "クリスマスだもの"
},
{
"t0": 59.1,
"t1": 59.72,
"text": "クリスマスか"
},
{
"t0": 60.44,
"t1": 61.68,
"text": "それまでに戻るよ"
},
{
"t0": 61.68,
"t1": 63.16,
"text": "ギリアン急ぎましょう"
},
{
"t0": 63.58,
"t1": 64.42,
"text": "約束よ"
},
{
"t0": 65.58,
"t1": 67.58,
"text": "絶対決めたから"
},
{
"t0": 68.5,
"t1": 69.42,
"text": "ああ、わかった。"
},
{
"t0": 70.47,
"t1": 72.53,
"text": "俺は一足先に礼拝に行ってくる"
},
{
"t0": 73.43,
"t1": 75.27,
"text": "行ってらっしゃい、ギリアン。"
},
{
