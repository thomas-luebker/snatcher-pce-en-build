[
{
"t0": 1.13,
"t1": 1.87,
"text": "親父さん"
},
{
"t0": 4.02,
"t1": 4.84,
"text": "う own"
},
{
"t0": 5.73,
"t1": 6.71,
"text": "ギリアンカー"
},
{
"t0": 7.72,
"t1": 9.84,
"text": "わしも年を取ってしまった"
},
{
"t0": 12.08,
"t1": 13.12,
"text": "このざまだ"
},
{
"t0": 14.19,
"t1": 15.07,
"text": "何があったんだ"
},
{
"t0": 16.26,
"t1": 17.96,
"text": "極、極超な"
},
{
"t0": 18.6,
"t1": 23.5,
"text": "あんたの、あんたの車に細工してるのを見たんじゃ。"
},
{
"t0": 24.1,
"t1": 29.42,
"text": "それから、やつの部屋のあの変な写真も、あふっ。"
},
{
"t0": 30.12,
"t1": 32.82,
"text": "メタルガン、親父さんの様態はどうなんだ"
},
{
"t0": 34.34,
"t1": 34.98,
"text": "メタル!"
},
{
"t0": 36.5,
"t1": 38.5,
"text": "私には言えません"
},
{
"t0": 40.18,
"t1": 41.7,
"text": "そうか、そんなに…"
},
{
"t0": 42.88,
"t1": 43.7,
"text": "キリオン"
},
{
"t0": 44.7,
"t1": 46.94,
"text": "奴はわしが問い詰めると"
},
{
"t0": 47.78,
"t1": 50.42,
"text": "あいつ正体見せやがった"
},
{
"t0": 51.5,
"t1": 52.34,
"text": "わしは"
},
{
"t0": 53.29,
"t1": 58.15,
"text": "わしは奴に傷を負わせるのがやっとじゃった"
},
{
"t0": 58.15,
"t1": 59.55,
"text": "おやさんわかった"
},
{
"t0": 60.43,
"t1": 61.37,
"text": "もしゃんな。"
},
{
"t0": 63.96,
"t1": 65.2,
"text": "なんとかならないのか"
},
{
"t0": 65.62,
"t1": 66.66,
"text": "イギリアン"
},
{
"t0": 69.6,
"t1": 70.32,
"text": "おやじさん"
},
{
"t0": 70.94,
"t1": 71.46,
"text": "大丈夫だ"
},
{
"t0": 72.09,
"t1": 73.27,
"text": "傷は軽いそうだ"
},
{
"t0": 74.2,
"t1": 75.1,
"text": "あ、ちょっといい"
},
{
"t0": 76.16,
"t1": 79.74,
"text": "この際休暇を取ってのんびりしたらどうだい"
},
{
"t0": 80.5,
"t1": 82.94,
"text": "おえさんは働きすぎだったからな"
},
{
"t0": 84.2,
"t1": 87.24,
"text": "いいんだよ自分の体じゃ"
},
{
"t0": 87.24,
"t1": 88.86,
"text": "よくわかった"
},
{
"t0": 91.79,
"t1": 93.57,
"text": "いい奴だろう"
},
{
"t0": 93.57,
"t1": 95.21,
"text": "宮司さん"
},
{
"t0": 96.12,
"t1": 100.84,
"text": "わしら、あんたが好きじゃ、まくりん。"
},
{
"t0": 102.0,
"t1": 102.94,
"text": "バイシアー"
},
{
"t0": 103.65,
"t1": 106.91,
"text": "人に伝えるのは苦手なんじゃ、昔から。"
},
{
"t0": 109.61,
"t1": 114.31,
"text": "わしの記憶に残っとる親父にどことなく似とるの"
},
{
"t0": 114.87,
"t1": 117.49,
"text": "脈拍、血圧、低下"
},
{
"t0": 117.49,
"t1": 119.35,
"text": "失敗しろ、親父だ!"
},
{
"t0": 120.88,
"t1": 121.74,
"text": "また一緒に"
},
{
"t0": 122.48,
"t1": 123.58,
"text": "ナポレオンやろうぜ"
},
{
"t0": 126.2,
"t1": 127.98,
"text": "それも悪くない"
},
{
"t0": 128.87,
"t1": 131.25,
"text": "ちゃんとお前さんと3人で"
},
{
"t0": 131.25,
"t1": 132.13,
"text": "じゃあは"
},
{
"t0": 132.13,
"t1": 133.03,
"text": "メタル"
},
{
"t0": 133.84,
"t1": 134.8,
"text": "インターン"
},
{
"t0": 135.9,
"t1": 138.04,
"text": "わしらギリアン"
},
{
"t0": 138.59,
"t1": 140.75,
"text": "ずっと一人で生きてきた。"
},
{
"t0": 142.31,
"t1": 144.23,
"text": "親も兄弟も死な"
},
{
"t0": 144.94,
"t1": 145.6,
"text": "じゃがら"
},
{
"t0": 146.46,
"t1": 148.88,
"text": "一人で頑固に生きてきたんだ。"
},
{
"t0": 149.34,
"t1": 150.96,
"text": "天使にばかりして。"
},
{
"t0": 152.68,
"t1": 154.3,
"text": "誰も信じずに。"
},
{
"t0": 155.05,
"t1": 157.41,
"text": "じゃあそれは間違いじゃった"
},
{
"t0": 160.21,
"t1": 162.63,
"text": "血圧さらに経過"
},
{
"t0": 165.61,
"t1": 167.23,
"text": "ジャンが死んで"
},
{
"t0": 167.89,
"t1": 169.09,
"text": "それから"
},
{
"t0": 170.08,
"t1": 172.14,
"text": "今わしは感じ取る"
},
{
"t0": 172.14,
"t1": 174.38,
"text": "人の温かさ"
},
{
"t0": 174.38,
"t1": 176.3,
"text": "人の心"
},
{
"t0": 176.3,
"t1": 177.52,
"text": "上がってる"
},
{
"t0": 179.05,
"t1": 179.89,
"text": "イリアン"
},
{
"t0": 180.74,
"t1": 186.86,
"text": "わしゃ、わしゃあの、みんなと仲良く暮らしたかった。"
},
{
"t0": 187.75,
"t1": 188.99,
"text": "なおめでしょ"
},
{
"t0": 190.01,
"t1": 190.73,
"text": "いらん"
},
{
"t0": 192.21,
"t1": 195.63,
"text": "わしが50年間、惜しかったな。"
},
{
"t0": 196.75,
"t1": 200.65,
"text": "優しさじゃ、信じ合える環境じゃ。"
},
{
"t0": 200.93,
"t1": 202.07,
"text": "危険です、ギリアン。"
},
{
"t0": 203.09,
"t1": 204.05,
"text": "ぬぬぬ fr"
},
{
"t0": 204.72,
"t1": 205.3,
"text": "うぃ.."
},
{
"t0": 205.97,
"t1": 207.33,
"text": "そう、すいたい。"
},
{
"t0": 208.81,
"t1": 211.31,
"text": "アトオ タノムズオ イビア"
},
{
"t0": 212.7,
"t1": 215.08,
"text": "どうやら、迎えが…"
},
{
"t0": 215.7,
"t1": 216.84,
"text": "よろしちゃう。"
},
{
"t0": 218.22,
"t1": 223.08,
"text": "ああ、孤独な老人にも迎えはあるようじゃ。"
},
{
"t0": 223.52,
"t1": 223.88,
"text": "おやつ!"
},
{
"t0": 226.66,
"t1": 230.32,
"text": "ギリアン、信じることじゃ。"
},
{
"t0": 230.98,
"t1": 231.54,
"text": "さっ"
},
{
"t0": 232.37,
"t1": 233.55,
"text": "最後の"
},
{
"t0": 234.52,
"t1": 234.98,
"text": "じゃあ"
},
{
"t0": 240.04,
"t1": 240.42,
"text": "はっし"
},
{
"t0": 241.45,
"t1": 241.95,
"text": "。"
},
{
"t0": 243.18,
"t1": 246.14,
"text": "脈拍停止しました"
},
{
"t0": 246.14,
"t1": 248.72,
"text": "動向開いています"
},
{
"t0": 253.31,
"t1": 257.27,
"text": "カニンガム!いや、スナッチャー許さん!"
},
{
"t0": 259.11,
"t1": 263.85,
"text": "悲しんでいる時間はありません。スナッチャーはまだこのポンブ内に潜んでいるんですよ。"
},
{
"t0": 264.54,
"t1": 265.2,
"text": "見てる!"
},
{
"t0": 265.79,
"t1": 266.63,
"text": "よく聞け"
},
{
"t0": 267.66,
"t1": 270.02,
"text": "万一俺がやられるようなことがあれば"
},
{
"t0": 270.57,
"t1": 271.77,
"text": "ミカを連れて逃げろ"
},
{
"t0": 272.65,
"t1": 274.57,
"text": "ジャンカーを本部ごと爆発するんだ!"
},
{
"t0": 274.93,
"t1": 275.57,
"text": "わかったか?"
},
{
"t0": 276.17,
"t1": 276.81,
"text": "わかりました。"
},
{
"t0": 277.63,
"t1": 279.23,
"text": "そうならないことを祈ります"
},
{
"t0": 280.59,
"t1": 281.93,
"text": "どこから探しましょう"
}
